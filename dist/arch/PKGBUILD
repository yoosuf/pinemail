# Maintainer: Yoosuf <yoosuf@users.noreply.github.com>
pkgname=pinemail-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Tiny single-binary SMTP & SMS catcher for development and AI agents"
arch=('x86_64' 'aarch64')
url="https://github.com/yoosuf/pinemail"
license=('MIT')
provides=('pinemail' 'pinemail-mcp')
conflicts=('pinemail')

source_x86_64=("https://github.com/yoosuf/pinemail/releases/download/v${pkgver}/pinemail-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("https://github.com/yoosuf/pinemail/releases/download/v${pkgver}/pinemail-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    install -Dm755 "${srcdir}/pinemail" "${pkgdir}/usr/bin/pinemail"
    if [ -f "${srcdir}/pinemail-mcp" ]; then
        install -Dm755 "${srcdir}/pinemail-mcp" "${pkgdir}/usr/bin/pinemail-mcp"
    fi
}
